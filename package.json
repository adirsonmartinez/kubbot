{
  "name": "platanus-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Visual IDE: your project as an isometric map, with an AI agent that builds and secures your code.",
  "author": "Platanus Hack 26 · team-12",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "vendor": "node scripts/vendor-ui.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "watch": "electron . --watch",
    "icons": "node scripts/build-icons.mjs",
    "build:web": "node scripts/build-web.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "test": "node --test electron/mcpServer.test.js electron/agentEvents.test.js electron/agentVoice.test.js electron/servers.test.js electron/git.test.js electron/agents.test.js tests/renderer/*.test.mjs tests/secrets.test.mjs"
  },
  "build": {
    "appId": "us.platan.hack26.team12.ide",
    "productName": "Platanus",
    "icon": "project-logo.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "agent/**",
      "package.json"
    ],
    "artifactName": "Platanus-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Platanus usa la cámara solo si activas mover el mapa con la mano. La imagen no sale de tu computador."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "border-beam": "^1.4.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "thinking-orbs": "^0.3.2"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "three": "^0.160.0"
  }
}
